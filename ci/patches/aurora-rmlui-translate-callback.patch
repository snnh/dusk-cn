+#ifdef WEBGPU_DAWN
+// Dawn's C cache-callback ABI differs between packages: older ones pass a single
+// userdata pointer, newer ones two. Both generations expose the same public C
+// descriptor fields, so the callbacks are wired through those and the matching
+// signature pair is selected at compile time (template specialization keeps the
+// unused pair out of the compilation entirely).
+static size_t dawn_load_cache_cb_6(size_t keySize, const uint8_t* key, size_t valueSize, uint8_t* value,
+                                   void* userdata1, void* userdata2) {
+  return load_from_cache(key, keySize, value, valueSize, userdata1 != nullptr ? userdata1 : userdata2);
+}
+static void dawn_store_cache_cb_6(size_t keySize, const uint8_t* key, size_t valueSize, const uint8_t* value,
+                                  void* userdata1, void* userdata2) {
+  store_to_cache(key, keySize, value, valueSize, userdata1 != nullptr ? userdata1 : userdata2);
+}
+static size_t dawn_load_cache_cb_5(size_t keySize, const uint8_t* key, size_t valueSize, uint8_t* value,
+                                   void* userdata) {
+  return load_from_cache(key, keySize, value, valueSize, userdata);
+}
+static void dawn_store_cache_cb_5(size_t keySize, const uint8_t* key, size_t valueSize, const uint8_t* value,
+                                  void* userdata) {
+  store_to_cache(key, keySize, value, valueSize, userdata);
+}
+template <typename T, typename = void>
+struct HasLegacyCacheCallbacks : std::false_type {};
+template <typename T>
+struct HasLegacyCacheCallbacks<T, std::void_t<decltype(std::declval<T&>().loadDataFunction),
+                                              decltype(std::declval<T&>().storeDataFunction)>>
+    : std::true_type {};
